---
import { resolveLanguageIcon } from "./language-icon-data";

export interface Props {
  icon: string;
  class?: string;
  title?: string;
}

const { icon, class: className = "", title, ...attributes } = Astro
  .props as Props;

const spriteIcon = resolveLanguageIcon(icon);
const iconTitle = title ?? spriteIcon.symbolId.replace(/^hf-lang-/, "");
---

<span
  class:list={["hf-language-icon inline-block", className]}
  role="img"
  aria-label={`${iconTitle} icon`}
  {...attributes}
>
  <svg viewBox={spriteIcon.viewBox}>
    <use href={`#${spriteIcon.symbolId}`} />
  </svg>
</span>

<style>
.hf-language-icon :global(svg) {
  display: block;
  width: 100%;
  height: 100%;
}
</style>
